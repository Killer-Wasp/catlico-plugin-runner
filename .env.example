# Copy this to .env and run `make dev` — the defaults below are wired for the
# local core stack (Catlico API on :8000, sibling catlico-plugins + catlico-plugin-sdk
# checkouts). Start the Catlico API FIRST: the runner registers synchronously on
# boot and exits with a ConnectError if the API isn't reachable yet.

# Catlico API (control plane) as reached by the runner.
PLUGIN_RUNNER_CATLICO_API_URL=http://localhost:8000

# Shared secret — MUST match PLUGIN_RUNNER_SHARED_SECRET on the Catlico API.
# It is the whole trust boundary: internal calls send it as a Bearer token and
# inbound event/rescan pushes are HMAC-verified against it. Runners self-register
# on startup (no enrollment token to mint). `changeme` matches the API's local
# dev default; a mismatch shows up as 401 on /register (not a ConnectError).
# Generate for non-local use: python -c "import secrets; print(secrets.token_hex(32))"
PLUGIN_RUNNER_SHARED_SECRET=changeme

# The URL the Catlico API uses to reach THIS runner for event pushes.
# Self-reported at registration; leave empty and the API cannot push to it.
PLUGIN_RUNNER_ADVERTISED_URL=http://localhost:8090

# Stable runner id (matches the plugin_runner row in Catlico).
PLUGIN_RUNNER_RUNNER_ID=runner-1

# Root dir of provisioned plugins (each is a full uv project). Baked images ship
# the catalog at /plugins; for local dev point this at the sibling catalog
# checkout. Read-only for `make dev` (venvs live under the cache dir, not here);
# only the `plugin-runner install` subcommand writes into it. First boot syncs a
# venv per plugin (slow + network) then caches — set to ./dev/plugins for an
# instant 0-plugin start while iterating on the runner itself.
PLUGIN_RUNNER_PLUGINS_DIR=../catlico-plugins

# Dev-only: install the SDK editable into every plugin venv from this checkout,
# so a running plugin picks up local SDK edits AND catalog plugins that pin the
# SDK from a private index still sync offline. Leave empty in production (the
# SDK resolves from each plugin's own lockfile — a git pin or an index).
PLUGIN_RUNNER_SDK_SOURCE=../catlico-plugin-sdk

# Optional: where per-plugin venvs and the uv cache live (default: a subdir of
# /var/cache/catlico if writable, else ~/.cache/catlico). Mount a persistent
# volume here to keep warm venvs across restarts / enable offline syncs.
# PLUGIN_RUNNER_VENVS_DIR=
# PLUGIN_RUNNER_UV_CACHE_DIR=

# Internal index / private wheelhouse settings are plain env passthrough to every
# `uv sync` (no runner-specific knob): UV_DEFAULT_INDEX, UV_INDEX_<NAME>_USERNAME/
# PASSWORD, UV_FIND_LINKS (e.g. /plugins/_wheelhouse), UV_NATIVE_TLS, UV_OFFLINE.
